# ─── LLM providers (multi-family cascade, at least one required) ─────────────
# Order of preference per stage lives in backend/src/providers/index.ts.

# Anthropic Claude — highest quality reasoner; used for grader A, validator,
# rubric generation, model-answer generation.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — best bbox-native vision extraction; grader fallback.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_GRADER_MODEL=gemini-3.6-flash-lite

# OpenAI — family-diverse grader B (enforced != grader A's family).
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Groq — emergency fallback (Llama-4 Scout, vision+text, extremely fast).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── Specialised OCR (optional but recommended) ──────────────────────────────

# Mathpix — per-equation OCR for math/physics/chemistry questions. ~$0.002/img.
# Sign up: https://accounts.mathpix.com/ocr-api
MATHPIX_APP_ID=your_mathpix_app_id
MATHPIX_APP_KEY=your_mathpix_app_key

# Google Cloud Vision Document AI — coordinate-precise word bboxes as
# escalation fallback when the VLM cascade disagrees on a crop.
#
# Three ways to auth (in priority order — pick ONE):
#
#   (a) Local development — easiest:
#       Install gcloud CLI, then run:
#         gcloud auth application-default login
#       The adapter auto-detects credentials from ~/.config/gcloud/.
#       Leave both variables below unset.
#
#   (b) Service account file:
#       GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
#   (c) Inline JSON (for hosts without a filesystem — Heroku, etc):
#       GOOGLE_CLOUD_VISION_CREDENTIALS={"type":"service_account",...}
#
# All three require the "Cloud Vision API" enabled in your GCP project.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_VISION_CREDENTIALS=

# ─── Server ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8090
FRONTEND_PORT=5190
